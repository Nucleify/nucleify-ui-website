---
import { DOCS_URL } from '../config';
import { FOOTER } from '../config/copy';
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="/logo-transparent.webp" alt="Nucleify UI logo" width="24" height="24" class="site-logo footer-logo site-logo--dark" />
        <img src="/logo-transparent-light.webp" alt="Nucleify UI logo" width="24" height="24" class="site-logo footer-logo site-logo--light" />
        <div>
          <span class="footer-name">nucleify<span class="footer-subname">/ui</span></span>
          <nui-paragraph class="footer-tag" text={FOOTER.tagline} />
        </div>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <span class="footer-col-title">{FOOTER.docsTitle}</span>
          <nui-anchor href={DOCS_URL} label="Installation" />
          <nui-anchor href="/components" label="Components" />
          <nui-anchor href="/resources" label="Resources" />
          <nui-anchor href="#theming" label="Design Tokens" />
        </div>
        <div class="footer-col">
          <span class="footer-col-title">{FOOTER.ecoTitle}</span>
          <nui-anchor href="https://github.com/Nucleify/nucleify-ui" label="GitHub" target="_blank" />
          <nui-anchor href="https://www.npmjs.com/package/nucleify-ui" label="npm package" target="_blank" />
          <nui-anchor href={FOOTER.nucleifyUrl} label={FOOTER.nucleifyLabel} target="_blank" />
        </div>
      </div>
    </div>
    <nui-divider />
    <div class="footer-bottom">
      <nui-paragraph class="footer-copy" text={FOOTER.legal} />
      <ul class="footer-badges">
        <li class="footer-chip">
          <nui-icon icon="mdi:lightning-bolt-outline" width="12" height="12" />
          <span>Lit 3</span>
        </li>
        <li class="footer-chip">
          <nui-icon icon="mdi:language-typescript" width="12" height="12" />
          <span>TypeScript</span>
        </li>
        <li class="footer-chip">
          <nui-icon icon="mdi:palette-outline" width="12" height="12" />
          <span>8 Presets</span>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--surface-border);
  padding: 3.5rem 0 2.5rem;
  background: var(--surface-section);
}

.footer-inner {
  display: grid;
  gap: 2rem;
}

.footer-main {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2.5rem;
}

.footer-brand {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.footer-logo {
  display: block;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  margin-top: 0.15rem;
}

.footer-name {
  display: block;
  font-family: 'Instrument Sans', sans-serif;
  font-weight: 600;
  font-size: 1rem;
  letter-spacing: -0.02em;
  margin-bottom: 0.2rem;
}

.footer-subname {
  opacity: 0.5;
  font-weight: 400;
}

.footer-tag {
  --font-size-xs: 0.8125rem;
  opacity: 0.55;
  max-width: 20rem;
}

.footer-cols {
  display: flex;
  gap: 3.5rem;
  flex-wrap: wrap;
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.footer-col-title {
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  opacity: 0.5;
  margin-bottom: 0.25rem;
}

.footer-col nui-anchor {
  --font-size-2xs: 0.8125rem;
  opacity: 0.75;
  transition: opacity 0.2s;
}

.footer-col nui-anchor:hover {
  opacity: 1;
}

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.footer-copy {
  --font-size-xs: 0.75rem;
  opacity: 0.5;
}

.footer-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.footer-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.625rem;
  border-radius: 999px;
  border: 1px solid var(--surface-border);
  background: color-mix(in srgb, var(--nui-bg-dark-color) 40%, transparent);
  color: color-mix(in srgb, var(--nui-white-text-color) 75%, transparent);
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
}

.footer-chip nui-icon {
  color: var(--nui-primary-color);
  opacity: 0.85;
}
</style>
