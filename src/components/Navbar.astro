---
import { DOCS_URL } from '../config';
---

<header class="navbar-wrap">
  <div class="navbar glass">
    <a href="/" class="navbar-brand">
      <img src="/logo-transparent.webp" alt="Nucleify UI logo" width="22" height="22" class="site-logo navbar-logo site-logo--dark" />
      <img src="/logo-transparent-light.webp" alt="Nucleify UI logo" width="22" height="22" class="site-logo navbar-logo site-logo--light" />
      <span class="navbar-name">nucleify<span class="navbar-subname">/ui</span></span>
    </a>
    <nav class="navbar-links">
      <nui-anchor href="#preview" label="Demo" />
      <nui-anchor href="#features" label="Features" />
      <nui-anchor href="#components" label="Components" />
      <nui-anchor href="#theming" label="Theming" />
      <nui-anchor href="#quickstart" label="Get Started" />
    </nav>
    <div class="navbar-actions" role="group" aria-label="Theme and docs">
      <nui-select class="navbar-preset-select" id="navbar-preset" size="small" aria-label="Theme preset"></nui-select>
      <nui-select-button class="navbar-toggle" id="navbar-mode" size="small" aria-label="Color mode" />
      <nui-button
        class="navbar-docs"
        label="Docs"
        icon="mdi:arrow-top-right"
        icon-pos="right"
        severity="primary"
        size="small"
        data-action="navigate"
        data-url={DOCS_URL}
      />
    </div>
    <nui-button id="mobile-toggle" icon="mdi:menu" label="" text rounded class="mobile-only" aria-label="Menu" data-action="toggle-mobile" />
  </div>
  <div class="mobile-nav glass" id="mobile-nav" hidden>
    <nui-anchor href="#preview" label="Demo" />
    <nui-anchor href="#features" label="Features" />
    <nui-anchor href="#components" label="Components" />
    <nui-anchor href="#theming" label="Theming" />
    <nui-anchor href="#quickstart" label="Get Started" />
    <nui-divider />
    <div class="mobile-nav-theme" role="group" aria-label="Theme controls">
      <nui-select class="navbar-preset-select" id="mobile-preset" size="small" fluid aria-label="Theme preset"></nui-select>
      <nui-select-button class="navbar-toggle" id="mobile-mode" size="small" aria-label="Color mode" />
    </div>
    <nui-button
      class="navbar-docs"
      label="Open Docs"
      icon="mdi:arrow-top-right"
      icon-pos="right"
      severity="primary"
      fluid
      data-action="navigate"
      data-url={DOCS_URL}
    />
  </div>
</header>

<style>
.navbar-wrap {
  position: fixed;
  top: 1rem;
  left: 0;
  right: 0;
  z-index: 100;
  padding-inline: 1rem;
  pointer-events: none;
}

.navbar {
  pointer-events: auto;
  max-width: 1080px;
  margin-inline: auto;
  display: flex;
  align-items: center;
  gap: 1.75rem;
  height: 3.25rem;
  padding-inline: 1.125rem 0.5rem;
  border-radius: 999px;
  box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.4);
}

.navbar-brand {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
  color: inherit;
}

.navbar-logo {
  display: block;
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}

.navbar-name {
  font-family: 'Instrument Sans', sans-serif;
  font-weight: 600;
  font-size: 0.9375rem;
  letter-spacing: -0.02em;
  white-space: nowrap;
}

.navbar-subname {
  opacity: 0.5;
  font-weight: 400;
}

.navbar-links {
  display: none;
  align-items: center;
  gap: 1.5rem;
  line-height: 1;
}

@media (min-width: 860px) {
  .navbar-links { display: flex; }
}

.navbar-links nui-anchor {
  --font-size-2xs: 0.8125rem;
  font-weight: 500;
  opacity: 0.8;
  transition: opacity 0.2s;
}

.navbar-links nui-anchor:hover {
  opacity: 1;
}

.navbar-actions {
  display: none;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
}

@media (min-width: 860px) {
  .navbar-actions { display: flex; }
}

.navbar-preset-select {
  min-width: 6.75rem;
  --border-radius-sm: 8px;
  --nui-select-panel-border-radius: 8px;
  --nui-card-background: var(--nui-bg-dark-color);
  --nui-card-border: var(--surface-border);
}

.navbar-toggle {
  --font-size-2xs: 0.75rem;
  --border-radius-sm: 8px;
}

.navbar-docs {
  --border-radius-sm: 1rem;
  --font-size-2xs: 0.75rem;
  margin-left: 0.25rem;
}

.mobile-only {
  display: flex;
  margin-left: auto;
}

@media (min-width: 860px) {
  .mobile-only { display: none; }
}

.mobile-nav {
  pointer-events: auto;
  max-width: 1080px;
  margin: 0.5rem auto 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1.25rem;
  border-radius: 1.25rem;
  box-shadow: 0 16px 48px -12px rgba(0, 0, 0, 0.5);
}

.mobile-nav[hidden] { display: none; }

.mobile-nav-theme {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.mobile-nav-theme .navbar-toggle {
  flex: 1 1 auto;
}
</style>
