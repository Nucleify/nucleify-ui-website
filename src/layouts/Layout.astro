---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { SITE } from "../config/copy";

import "nucleify-ui/styles/variables.css";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = "/og-image.png",
  imageAlt = SITE.imageAlt,
} = Astro.props;

const siteBase = Astro.site ?? "https://ui.nucleify.io";
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;
const imageURL = new URL(image, siteBase).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "nucleify-ui",
      url: siteBase,
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      name: "nucleify-ui",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web",
      description,
      url: siteBase,
      image: imageURL,
      softwareVersion: "1.0",
      license: "https://opensource.org/licenses/MIT",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      programmingLanguage: ["TypeScript", "JavaScript"],
    },
    {
      "@type": "SoftwareSourceCode",
      name: "nucleify-ui",
      codeRepository: "https://github.com/Nucleify/nucleify-ui",
      programmingLanguage: "TypeScript",
      runtimePlatform: "Lit 3",
      license: "https://opensource.org/licenses/MIT",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nucleify-ui" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href="/fonts/Instrument_Sans-normal-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Instrument_Sans-normal-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JetBrains_Mono-normal-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      html {
        background: var(--nui-bg-dark-color, #090a0f);
        color: var(--nui-white-text-color, #f5f5f7);
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family:
          "Instrument Sans",
          "Instrument Sans Fallback",
          system-ui,
          -apple-system,
          sans-serif;
      }

      body.nui-dark {
        background: var(--nui-bg-dark-color, #090a0f);
        color: var(--nui-white-text-color, #f5f5f7);
      }

      body.nui-light {
        background: var(--nui-bg-dark-color, #fafafc);
        color: var(--nui-white-text-color, #0f172a);
      }

      /* Avoid layout jump before web components upgrade + adopt styles */
      :not(:defined) {
        visibility: hidden !important;
      }

      body:not(.styles-ready) {
        visibility: hidden;
      }

      body.styles-ready {
        visibility: visible;
      }
    </style>
  </head>
  <body class="nui-preset-nucleus nui-dark">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <nui-toast position="top-right"></nui-toast>
    <nui-scroll-top threshold="300"></nui-scroll-top>

    <script is:inline>
      // Safety: never leave the page invisible if fonts/module graph stall.
      window.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => document.body.classList.add("styles-ready"), 2200);
      });
    </script>
    <script>
      import "../scripts/main.ts";

      async function reveal() {
        try {
          await Promise.all([
            customElements.whenDefined("nui-card"),
            customElements.whenDefined("nui-button"),
            customElements.whenDefined("nui-heading"),
            customElements.whenDefined("nui-paragraph"),
            customElements.whenDefined("nui-select-button"),
            customElements.whenDefined("nui-select"),
            customElements.whenDefined("nui-anchor"),
            customElements.whenDefined("nui-logo"),
            customElements.whenDefined("nui-icon"),
          ]);

          // Load fonts into document font set
          await Promise.all([
            document.fonts.load('400 16px "Instrument Sans"'),
            document.fonts.load('600 16px "Instrument Sans"'),
            document.fonts.load('600 14px "JetBrains Mono"'),
          ]);

          await Promise.race([
            document.fonts.ready,
            new Promise((resolve) => setTimeout(resolve, 1500)),
          ]);

          // Let shadow patches settle
          await new Promise((resolve) => setTimeout(resolve, 50));
          await new Promise<void>((resolve) => {
            requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
          });

          // First viewport initial check
          const fold = window.innerHeight * 0.95;
          document.querySelectorAll(".reveal").forEach((el) => {
            if (el.getBoundingClientRect().top < fold) {
              el.classList.add("visible");
            }
          });
        } catch {
          /* ignore */
        }
        document.body.classList.add("styles-ready");
      }

      void reveal();
    </script>
  </body>
</html>
