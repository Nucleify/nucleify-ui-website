---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";

import "nucleify-ui/styles/variables.css";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = "nucleify-ui - Universal UI for modern web apps",
  description = "Tree-shakeable Lit 3 web components with native tokens, 8 design presets, and zero runtime bloat. Works with any framework — or none at all.",
  image = "/og-image.png",
  imageAlt = "Nucleify UI - Universal Web Component Library with lit 3 and native design tokens",
} = Astro.props;

const siteBase = Astro.site ?? "https://ui.nucleify.io";
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;
const imageURL = new URL(image, siteBase).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link
      rel="preload"
      href="/fonts/Instrument_Sans-normal-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Instrument_Sans-normal-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JetBrains_Mono-normal-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      html {
        background: #090a0f;
        color: #f5f5f7;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family:
          "Instrument Sans",
          "Instrument Sans Fallback",
          system-ui,
          -apple-system,
          sans-serif;
      }

      body.nui-theme-dark-nuxt,
      body.nui-theme-dark-next {
        background: #090a0f;
        color: #f5f5f7;
      }

      body.nui-theme-light-nuxt,
      body.nui-theme-light-next {
        background: #fafafc;
        color: #0f172a;
      }

      /* Avoid layout jump before web components upgrade + adopt styles */
      :not(:defined) {
        visibility: hidden !important;
      }

      body:not(.styles-ready) {
        visibility: hidden;
      }

      body.styles-ready {
        visibility: visible;
      }
    </style>
    <title>{title}</title>
  </head>
  <body class="nui-preset-nucleus nui-dark">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <nui-toast position="top-right"></nui-toast>
    <nui-scroll-top threshold="300"></nui-scroll-top>

    <script is:inline>
      // Safety: never leave the page invisible if fonts/module graph stall.
      window.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => document.body.classList.add("styles-ready"), 2200);
      });
    </script>
    <script>
      import "../scripts/main.ts";

      async function reveal() {
        try {
          await Promise.all([
            customElements.whenDefined("nui-card"),
            customElements.whenDefined("nui-button"),
            customElements.whenDefined("nui-heading"),
            customElements.whenDefined("nui-paragraph"),
            customElements.whenDefined("nui-select-button"),
            customElements.whenDefined("nui-select"),
            customElements.whenDefined("nui-anchor"),
            customElements.whenDefined("nui-logo"),
            customElements.whenDefined("nui-icon"),
          ]);

          // Load fonts into document font set
          await Promise.all([
            document.fonts.load('400 16px "Instrument Sans"'),
            document.fonts.load('600 16px "Instrument Sans"'),
            document.fonts.load('600 14px "JetBrains Mono"'),
          ]);

          await Promise.race([
            document.fonts.ready,
            new Promise((resolve) => setTimeout(resolve, 1500)),
          ]);

          // Let shadow patches settle
          await new Promise((resolve) => setTimeout(resolve, 50));
          await new Promise<void>((resolve) => {
            requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
          });

          // First viewport initial check
          const fold = window.innerHeight * 0.95;
          document.querySelectorAll(".reveal").forEach((el) => {
            if (el.getBoundingClientRect().top < fold) {
              el.classList.add("visible");
            }
          });
        } catch {
          /* ignore */
        }
        document.body.classList.add("styles-ready");
      }

      void reveal();
    </script>
  </body>
</html>
