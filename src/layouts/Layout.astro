---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';

import 'nucleify-ui/styles/variables.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'nucleify-ui — Web Component Library',
  description = 'Tree-shakeable Lit 3 web components with TypeScript, themes, and an interactive playground.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-ext-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      /* Critical: discover fonts before module CSS arrives */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 800;
        font-display: block;
        src: url('/fonts/inter-latin-ext-var.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 800;
        font-display: block;
        src: url('/fonts/inter-latin-var.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Inter Fallback';
        src: local('Arial'), local('Helvetica Neue'), local('Helvetica');
        size-adjust: 107.64%;
        ascent-override: 90.49%;
        descent-override: 22.56%;
        line-gap-override: 0%;
      }

      html {
        background: #080808;
        color: #f5f4f4;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family: 'Inter', 'Inter Fallback', system-ui, -apple-system, sans-serif;
      }

      body.nui-theme-dark-nuxt,
      body.nui-theme-dark-next {
        background: #080808;
        color: #f5f4f4;
      }

      body.nui-theme-light-nuxt,
      body.nui-theme-light-next {
        background: #fff;
        color: #0f2e23;
      }

      body.nui-theme-light-next {
        color: #0f172a;
      }

      /* Avoid layout jump before web components upgrade + adopt styles */
      :not(:defined) {
        visibility: hidden !important;
      }

      body:not(.styles-ready) {
        visibility: hidden;
      }

      body.styles-ready {
        visibility: visible;
      }
    </style>
    <title>{title}</title>
  </head>
  <body class="nui-primary-palette-nuxt nui-theme-dark-nuxt">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <nui-toast position="top-right" />
    <nui-scroll-top threshold="300" />

    <script is:inline>
      // Safety: never leave the page invisible if fonts/module graph stall.
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => document.body.classList.add('styles-ready'), 2500);
      });
    </script>
    <script>
      import '../scripts/main.ts';

      async function reveal() {
        try {
          await Promise.all([
            customElements.whenDefined('nui-card'),
            customElements.whenDefined('nui-button'),
            customElements.whenDefined('nui-heading'),
            customElements.whenDefined('nui-paragraph'),
            customElements.whenDefined('nui-select-button'),
            customElements.whenDefined('nui-anchor'),
            customElements.whenDefined('nui-logo'),
            customElements.whenDefined('nui-icon'),
          ]);

          // Warm Inter into the document font set (latin + latin-ext).
          await Promise.all([
            document.fonts.load('400 16px Inter'),
            document.fonts.load('500 16px Inter'),
            document.fonts.load('600 16px Inter'),
            document.fonts.load('700 16px Inter'),
            document.fonts.load('800 24px Inter'),
          ]);

          await Promise.race([
            document.fonts.ready,
            new Promise((resolve) => setTimeout(resolve, 2000)),
          ]);

          // Let Lit/shadow patches (navbar toggles, cards) settle before first paint.
          await new Promise((resolve) => setTimeout(resolve, 80));
          await new Promise<void>((resolve) => {
            requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
          });

          // First viewport should not "jump in" via reveal animation on initial paint.
          const fold = window.innerHeight * 0.95;
          document.querySelectorAll('.reveal').forEach((el) => {
            if (el.getBoundingClientRect().top < fold) {
              el.classList.add('visible');
            }
          });
        } catch {
          /* ignore */
        }
        document.body.classList.add('styles-ready');
      }

      void reveal();
    </script>
  </body>
</html>
