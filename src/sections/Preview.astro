---

---

<section class="section section-preview" id="preview">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Interactive Preview</span>
      <nui-heading
        tag="2"
        class="section-title"
        text="Compact. Fast. Pure Web Components."></nui-heading>
      <nui-paragraph
        class="section-lead"
        text="Every widget reacts to live inputs and token changes. Test the period switcher or switch presets in the navbar."
      ></nui-paragraph>
    </div>

    <div class="preview-shell reveal">
      <div class="preview-glow-backdrop" aria-hidden="true"></div>

      <div class="preview-frame">
        <!-- Compact Header -->
        <header class="app-header">
          <div class="app-brand">
            <img
              src="/logo.svg"
              alt="Nucleify logo"
              width="18"
              height="18"
              class="app-logo"
            />
            <span class="app-title"
              >nucleify<span class="app-sub">/ui</span></span
            >
            <span class="app-tag">Live</span>
          </div>

          <div class="app-header-controls">
            <nui-select-button id="chart-period" size="small"
            ></nui-select-button>
            <div class="latency-indicator">
              <span class="latency-dot"></span>
              <span>18ms</span>
            </div>
            <nui-avatar label="NX" shape="circle" size="small"></nui-avatar>
          </div>
        </header>

        <!-- Compact Main Grid -->
        <div class="app-body">
          <!-- 3 KPI Stat Tiles -->
          <div class="stat-tiles-row">
            <div class="stat-card">
              <div class="stat-label-wrap">
                <span class="stat-label">Monthly Run Rate</span>
                <nui-icon
                  icon="mdi:trending-up"
                  width="14"
                  height="14"
                  class="icon-success"></nui-icon>
              </div>
              <div class="stat-val">$58,400</div>
              <div class="stat-sub">
                <span class="badge success">+9.8%</span> target delta
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-label-wrap">
                <span class="stat-label">Active Concurrency</span>
                <nui-icon
                  icon="mdi:account-group-outline"
                  width="14"
                  height="14"
                  class="icon-primary"></nui-icon>
              </div>
              <div class="stat-val">24,850</div>
              <div class="stat-sub">
                <span class="badge primary">+14.2%</span> live sessions
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-label-wrap">
                <span class="stat-label">Global P99 Edge</span>
                <nui-icon
                  icon="mdi:speedometer"
                  width="14"
                  height="14"
                  class="icon-info"></nui-icon>
              </div>
              <div class="stat-val">42ms</div>
              <div class="stat-sub">
                <span class="badge info">Cloudflare</span> global SLA
              </div>
            </div>
          </div>

          <!-- 2-Panel Content Row -->
          <div class="content-row">
            <!-- Left: Chart Card -->
            <nui-card class="chart-box">
              <div class="box-head">
                <div>
                  <nui-heading tag="4" text="Revenue & Operations Stream"
                  ></nui-heading>
                  <nui-paragraph
                    text="Real-time telemetry (nui-chart)"
                    class="box-sub"></nui-paragraph>
                </div>
                <div class="chart-legend" id="chart-legend">
                  <span class="legend-item"
                    ><i class="legend-dot dot-income"></i>Income</span
                  >
                  <span class="legend-item"
                    ><i class="legend-dot dot-expense"></i>Expenses</span
                  >
                </div>
              </div>
              <div class="chart-wrap">
                <nui-chart id="showcase-chart" type="line"></nui-chart>
              </div>
            </nui-card>

            <!-- Right: Telemetry & Rollout Box -->
            <div class="side-boxes">
              <!-- Node Capacity -->
              <nui-card class="side-card">
                <div class="box-head">
                  <nui-heading tag="4" text="Cluster Capacity"></nui-heading>
                  <nui-tag value="36/50 Nodes" severity="success" rounded></nui-tag>
                </div>
                <div class="knob-row">
                  <nui-knob
                    id="goal-knob"
                    value="72"
                    size="60"
                    stroke-width="7"
                    show-value
                    value-template="{value}%"
                    readonly></nui-knob>
                  <div class="knob-meta">
                    <strong>Cluster Load Optimal</strong>
                    <span>Headroom: 28% reserve</span>
                  </div>
                </div>
                <div class="card-detail-list">
                  <div class="detail-row">
                    <span class="detail-label">Active Shards</span>
                    <span class="detail-val">128 partitions</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Autoscaling Threshold</span>
                    <nui-badge value="Armed (85%)" severity="info"></nui-badge>
                  </div>
                </div>
              </nui-card>

              <!-- Traffic Split & Ingestion -->
              <nui-card class="side-card">
                <div class="box-head">
                  <nui-heading tag="4" text="Traffic Routing"></nui-heading>
                  <nui-tag value="+4.8% delta" severity="info" rounded></nui-tag>
                </div>
                <div class="meter-box">
                  <nui-meter-group id="showcase-meter"></nui-meter-group>
                </div>
                <div class="card-detail-list">
                  <div class="detail-row">
                    <span class="detail-label">Peak Ingestion</span>
                    <span class="detail-val">14.2k req/sec</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Global CDN Hitrate</span>
                    <span class="detail-val text-success">99.4% edge</span>
                  </div>
                </div>
              </nui-card>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .preview-shell {
    position: relative;
    max-width: 860px;
    margin-inline: auto;
  }

  .preview-glow-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    height: 80%;
    background: radial-gradient(
      ellipse 60% 50% at 50% 50%,
      color-mix(in srgb, var(--nui-primary-color) 12%, transparent),
      transparent 70%
    );
    pointer-events: none;
    filter: blur(50px);
    z-index: 0;
  }

  .preview-frame {
    position: relative;
    z-index: 1;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 1px solid var(--surface-border-strong);
    background: var(--surface-card);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--nui-white-text-color) 5%, transparent),
      0 20px 50px -12px rgba(0, 0, 0, 0.6);
  }

  /* Compact Header */
  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    background: color-mix(in srgb, var(--nui-bg-dark-color) 70%, transparent);
    border-bottom: 1px solid var(--surface-border);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .app-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .app-logo {
    display: block;
  }

  .app-title {
    font-family: "Instrument Sans", sans-serif;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
  }

  .app-sub {
    opacity: 0.5;
    font-weight: 400;
  }

  .app-tag {
    font-family: var(--mono);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.1rem 0.375rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nui-success-color) 15%, transparent);
    color: var(--nui-success-color);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .app-header-controls {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-left: auto;
  }

  .latency-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--nui-secondary-text-color);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nui-white-text-color) 4%, transparent);
    border: 1px solid var(--surface-border);
  }

  .latency-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--nui-success-color);
    box-shadow: 0 0 6px var(--nui-success-color);
  }

  /* App Body */
  .app-body {
    padding: 1rem;
    display: grid;
    gap: 0.875rem;
  }

  /* 3 Stat Tiles */
  .stat-tiles-row {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(1, 1fr);
  }

  @media (min-width: 600px) {
    .stat-tiles-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat-card {
    padding: 0.875rem 1rem;
    border-radius: var(--border-radius-sm, 0.625rem);
    border: var(--border-width, 1px) solid var(--nui-card-border);
    background: var(--nui-card-background);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    box-sizing: border-box;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .stat-card:hover {
    border-color: color-mix(in srgb, var(--nui-primary-color) 40%, var(--nui-card-border));
  }

  .stat-label-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--nui-secondary-text-color);
    opacity: 0.75;
  }

  .icon-success {
    color: var(--nui-success-color);
  }
  .icon-primary {
    color: var(--nui-primary-color);
  }
  .icon-info {
    color: var(--nui-info-color);
  }

  .stat-val {
    font-family: "Instrument Sans", sans-serif;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--nui-white-text-color);
    line-height: 1.15;
  }

  .stat-sub {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    color: var(--nui-secondary-text-color);
    opacity: 0.65;
  }

  .badge {
    font-family: var(--mono);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
  }

  .badge.success {
    background: color-mix(in srgb, var(--nui-success-color) 15%, transparent);
    color: var(--nui-success-color);
  }
  .badge.primary {
    background: color-mix(in srgb, var(--nui-primary-color) 15%, transparent);
    color: var(--nui-primary-color);
  }
  .badge.info {
    background: color-mix(in srgb, var(--nui-info-color) 15%, transparent);
    color: var(--nui-info-color);
  }

  /* Content Row */
  .content-row {
    display: grid;
    gap: 0.875rem;
  }

  @media (min-width: 768px) {
    .content-row {
      grid-template-columns: 1.65fr 1fr;
      align-items: stretch;
    }
  }

  .chart-box,
  .side-card {
    display: flex;
    flex-direction: column;
    --border-radius-sm: 0.625rem;
    min-height: 0;
  }

  .side-boxes {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    height: 100%;
  }

  .side-card {
    flex: 1 1 0%;
  }

  .box-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .box-head nui-heading {
    --font-size-md: 0.875rem;
    --font-weight-semibold: 600;
  }

  .box-sub {
    --font-size-xs: 0.6875rem;
    opacity: 0.5;
    margin: 0.1rem 0 0;
  }

  .chart-legend {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    opacity: 0.75;
  }

  .legend-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
  }

  .dot-income {
    background: var(--nui-primary-color);
  }
  .dot-expense {
    background: var(--nui-danger-color);
  }

  .chart-wrap {
    width: 100%;
    flex: 1;
    min-height: 12rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-top: 0.875rem;
  }

  #showcase-chart {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12rem;
  }

  /* Knob Row */
  .knob-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .knob-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .knob-meta strong {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .knob-meta span {
    font-family: var(--mono);
    font-size: 0.6875rem;
    opacity: 0.55;
  }

  .meter-box {
    padding-block: 0.2rem;
  }

  #showcase-meter {
    display: block;
    width: 100%;
  }

  .card-detail-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid color-mix(in srgb, var(--surface-border) 60%, transparent);
  }

  .detail-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6875rem;
  }

  .detail-label {
    color: var(--nui-secondary-text-color);
    opacity: 0.7;
    font-size: 0.6875rem;
  }

  .detail-val {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--nui-white-text-color);
    font-size: 0.6875rem;
  }

  .text-success {
    color: var(--nui-success-color);
  }
</style>
