---
import { DOCS_URL, INSTALL_COMMAND } from "../config";
import { HERO } from "../config/copy";
---

<section class="hero">
  <div class="hero-subtle-glow" aria-hidden="true"></div>
  <div class="hero-grid-bg" aria-hidden="true">
    <div class="hero-grid-layer hero-grid-layer-1"></div>
    <div class="hero-grid-layer hero-grid-layer-2"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-badge-wrap">
      <a
        class="hero-pill"
        href="https://www.npmjs.com/package/nucleify-ui"
        target="_blank"
        rel="noopener"
      >
        <span class="hero-pill-badge">v1.0</span>
        <span class="hero-pill-text">{HERO.badge.replace(/^v1\.0 · /, "")}</span>
        <nui-icon
          icon="mdi:arrow-right"
          width="13"
          height="13"
          class="hero-pill-arrow"></nui-icon>
      </a>
    </div>

    <nui-heading tag="1" class="hero-title">
      <span class="hero-line">{HERO.titleLine1}</span>
      <span class="hero-line gradient-text">{HERO.titleLine2}</span>
    </nui-heading>

    <nui-paragraph
      class="hero-lead"
      text={HERO.lead}
    ></nui-paragraph>

    <div class="hero-actions">
      <nui-button
        label={HERO.ctaPrimary}
        severity="primary"
        raised
        icon="mdi:rocket-launch"
        data-action="scroll"
        data-target="#quickstart"></nui-button>
      <nui-button
        label={HERO.ctaSecondary}
        severity="secondary"
        outlined
        icon="mdi:gamepad-variant-outline"
        data-action="navigate"
        data-url={DOCS_URL}></nui-button>
    </div>

    <div class="hero-install-shell">
      <div class="hero-install">
        <span class="install-prompt">$</span>
        <code class="install-code">{INSTALL_COMMAND}</code>
        <nui-button
          icon="mdi:content-copy"
          label=""
          text
          rounded
          size="small"
          data-action="copy-install"
          aria-label="Copy install command"
          class="copy-btn"></nui-button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 8.5rem 0 3.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-subtle-glow {
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-50%);
    width: 640px;
    height: 480px;
    background: radial-gradient(
      ellipse 65% 55% at 50% 50%,
      color-mix(in srgb, var(--nui-primary-color) 18%, transparent),
      transparent 70%
    );
    pointer-events: none;
    filter: blur(40px);
  }

  .hero-grid-bg {
    --hero-dot: var(--nui-primary-color);
    --hero-dot-soft: var(--nui-primary-hover-color);
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    mask-image: radial-gradient(
      ellipse 78% 68% at 50% 36%,
      #000 8%,
      transparent 76%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 78% 68% at 50% 36%,
      #000 8%,
      transparent 76%
    );
  }

  .hero-grid-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--hero-dot) 12%, transparent) 1px,
      transparent 1px
    );
    background-size: 42px 42px;
  }

  .hero-grid-layer {
    position: absolute;
    inset: -25%;
    background-repeat: repeat;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    will-change: mask-position, opacity;
  }

  .hero-grid-layer-1 {
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--hero-dot) 95%, transparent) 1.6px,
      color-mix(in srgb, var(--hero-dot) 35%, transparent) 3.5px,
      transparent 4px
    );
    background-size: 42px 42px;
    -webkit-mask-image: linear-gradient(
      32deg,
      transparent 38%,
      #000 50%,
      transparent 62%
    );
    mask-image: linear-gradient(
      32deg,
      transparent 38%,
      #000 50%,
      transparent 62%
    );
    -webkit-mask-size: 240% 240%;
    mask-size: 240% 240%;
    animation: hero-grid-wave-1 6s ease-in-out infinite;
  }

  .hero-grid-layer-2 {
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--hero-dot-soft) 88%, transparent) 1.55px,
      color-mix(in srgb, var(--hero-dot-soft) 30%, transparent) 3.25px,
      transparent 3.75px
    );
    background-size: 42px 42px;
    background-position: 21px 11px;
    -webkit-mask-image: linear-gradient(
      -52deg,
      transparent 37%,
      #000 50%,
      transparent 63%
    );
    mask-image: linear-gradient(
      -52deg,
      transparent 37%,
      #000 50%,
      transparent 63%
    );
    -webkit-mask-size: 220% 220%;
    mask-size: 220% 220%;
    animation: hero-grid-wave-2 9s ease-in-out infinite;
  }

  @keyframes hero-grid-wave-1 {
    0% {
      -webkit-mask-position: 0% 20%;
      mask-position: 0% 20%;
      opacity: 0.08;
    }
    50% {
      -webkit-mask-position: 100% 80%;
      mask-position: 100% 80%;
      opacity: 1;
    }
    100% {
      -webkit-mask-position: 0% 20%;
      mask-position: 0% 20%;
      opacity: 0.08;
    }
  }

  @keyframes hero-grid-wave-2 {
    0% {
      -webkit-mask-position: 100% 10%;
      mask-position: 100% 10%;
      opacity: 0.06;
    }
    50% {
      -webkit-mask-position: 0% 90%;
      mask-position: 0% 90%;
      opacity: 1;
    }
    100% {
      -webkit-mask-position: 100% 10%;
      mask-position: 100% 10%;
      opacity: 0.06;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin-inline: auto;
  }

  .hero-badge-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.3rem 0.875rem 0.3rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border-strong);
    background: color-mix(in srgb, var(--nui-bg-dark-color) 70%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--nui-white-text-color);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.25);
  }

  .hero-pill:hover {
    border-color: var(--nui-primary-color);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -4px
      color-mix(in srgb, var(--nui-primary-color) 25%, transparent);
  }

  .hero-pill-badge {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--nui-primary-color);
    color: #fff;
    letter-spacing: 0.02em;
  }

  .hero-pill-text {
    font-weight: 500;
    letter-spacing: -0.01em;
    opacity: 0.9;
  }

  .hero-pill-arrow {
    opacity: 0.6;
    transition:
      transform 0.2s,
      opacity 0.2s;
  }

  .hero-pill:hover .hero-pill-arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  .hero-title {
    --font-size-2xl: clamp(1.75rem, 6.2vw, 4rem);
    --font-weight-semibold: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }

  .hero-line {
    display: block;
    white-space: nowrap;
  }

  .hero-lead {
    --font-size-xs: clamp(1.0625rem, 1.6vw, 1.25rem);
    max-width: 38rem;
    margin-inline: auto;
    margin-bottom: 2.25rem;
    opacity: 0.72;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-bottom: 2.5rem;
  }

  .hero-install-shell {
    display: flex;
    justify-content: center;
  }

  .hero-install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0.5rem 0.375rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--code-border);
    background: var(--code-surface);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.12);
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }

  .hero-install:hover {
    border-color: color-mix(in srgb, var(--nui-primary-color) 45%, transparent);
    box-shadow: 0 6px 24px -2px
      color-mix(in srgb, var(--nui-primary-color) 16%, transparent);
  }

  .install-prompt {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--nui-primary-color);
    opacity: 0.8;
  }

  .install-code {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--code-fg);
    letter-spacing: 0.01em;
  }

  /* Host-only; inner .nui-button size is patched in main.ts (shadow DOM) */
  .copy-btn {
    opacity: 0.7;
  }

  .copy-btn:hover {
    opacity: 1;
  }
</style>
