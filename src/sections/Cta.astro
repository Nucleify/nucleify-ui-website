---
import { INSTALL_COMMAND } from '../config';
---

<section class="cta-section">
  <div class="container cta-inner">
    <span class="cta-eyebrow">Ready to Deploy?</span>
    <nui-heading tag="2" class="cta-title">
      Build with <span class="gradient-text">effortless precision</span>
    </nui-heading>
    <nui-paragraph class="cta-lead" text="Zero runtime coupling. Complete styling freedom with native Web Components and design tokens." />
    <div class="cta-actions">
      <nui-button label="Get Started Now" severity="primary" raised icon="mdi:rocket-launch" data-action="scroll" data-target="#quickstart" />
      <nui-button label="GitHub Repository" severity="secondary" outlined icon="mdi:github" data-action="open-url" data-url="https://github.com/Nucleify/nucleify-ui" />
    </div>
    <div class="cta-install-shell">
      <code class="cta-install">$ {INSTALL_COMMAND}</code>
    </div>
  </div>
</section>

<style>
.cta-section {
  position: relative;
  text-align: center;
  padding: 6.5rem 0;
  overflow: hidden;
  border-top: 1px solid var(--surface-border);
  background: var(--surface-section);
}

.cta-inner {
  position: relative;
  max-width: 640px;
  margin-inline: auto;
}

.cta-eyebrow {
  display: inline-block;
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--nui-primary-color);
  margin-bottom: 0.75rem;
}

.cta-title {
  --font-size-xl: clamp(2rem, 4.5vw, 3rem);
  --font-weight-semibold: 600;
  letter-spacing: -0.03em;
  margin-bottom: 1rem;
}

.cta-lead {
  --font-size-xs: 1rem;
  opacity: 0.65;
  margin-bottom: 2rem;
  line-height: 1.6;
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: 2rem;
}

.cta-install-shell {
  display: inline-flex;
}

.cta-install {
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.4rem 1rem;
  border-radius: 999px;
  border: 1px solid var(--surface-border);
  background: color-mix(in srgb, var(--nui-bg-dark-color) 60%, transparent);
  color: var(--nui-white-text-color);
  opacity: 0.75;
}
</style>
