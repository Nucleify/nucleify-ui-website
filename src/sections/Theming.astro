---
import { THEMING } from '../config/copy';
---

<section class="section" id="theming">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">{THEMING.eyebrow}</span>
      <nui-heading tag="2" class="section-title">
        {THEMING.titleLine1}<br />{THEMING.titleLine2}
      </nui-heading>
      <nui-paragraph class="section-lead" text={THEMING.lead} />
    </div>

    <!-- 8 Presets Interactive Carousel / Grid -->
    <div class="preset-selector-grid" role="radiogroup" aria-label="Theme presets">
      <button type="button" class="site-card preset-card is-active" data-preset="nucleus">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #6366f1;"></span>
          <strong>Nucleus</strong>
          <span class="preset-tag">Enterprise</span>
        </div>
        <p class="preset-desc">Balanced indigo & slate system for enterprise dashboards.</p>
        <div class="preset-palette-row">
          <span style="background: #6366f1;"></span>
          <span style="background: #4f46e5;"></span>
          <span style="background: #818cf8;"></span>
          <span style="background: #c7d2fe;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="quantum">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #10b981;"></span>
          <strong>Quantum</strong>
          <span class="preset-tag">Cybernetic</span>
        </div>
        <p class="preset-desc">Emerald & zinc glassmorphic bento theme.</p>
        <div class="preset-palette-row">
          <span style="background: #10b981;"></span>
          <span style="background: #059669;"></span>
          <span style="background: #34d399;"></span>
          <span style="background: #a7f3d0;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="kinetic">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #f59e0b;"></span>
          <strong>Kinetic</strong>
          <span class="preset-tag">Terminal</span>
        </div>
        <p class="preset-desc">Amber & true-black high-density technical UI.</p>
        <div class="preset-palette-row">
          <span style="background: #f59e0b;"></span>
          <span style="background: #d97706;"></span>
          <span style="background: #fbbf24;"></span>
          <span style="background: #fde68a;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="cosmos">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #a855f7;"></span>
          <strong>Cosmos</strong>
          <span class="preset-tag">Cyberpunk</span>
        </div>
        <p class="preset-desc">Electric violet & cyan luminescence.</p>
        <div class="preset-palette-row">
          <span style="background: #a855f7;"></span>
          <span style="background: #9333ea;"></span>
          <span style="background: #c084fc;"></span>
          <span style="background: #d8b4fe;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="apex">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #f43f5e;"></span>
          <strong>Apex</strong>
          <span class="preset-tag">Crimson Noir</span>
        </div>
        <p class="preset-desc">Deep ruby & rose editorial luxury styling.</p>
        <div class="preset-palette-row">
          <span style="background: #f43f5e;"></span>
          <span style="background: #e11d48;"></span>
          <span style="background: #fb7185;"></span>
          <span style="background: #fecdd3;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="eclipse">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #ffffff;"></span>
          <strong>Eclipse</strong>
          <span class="preset-tag">Monochrome</span>
        </div>
        <p class="preset-desc">Pure achromatic black & white contrast.</p>
        <div class="preset-palette-row">
          <span style="background: #ffffff;"></span>
          <span style="background: #a3a3a3;"></span>
          <span style="background: #525252;"></span>
          <span style="background: #171717;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="prism">
        <div class="preset-card-top">
          <span class="preset-dot preset-dot-rainbow"></span>
          <strong>Prism</strong>
          <span class="preset-tag">Chromatic</span>
        </div>
        <p class="preset-desc">Full-spectrum rainbow powered by nui-rainbow.</p>
        <div class="preset-palette-row preset-palette-rainbow">
          <span style="background: #ef4444;"></span>
          <span style="background: #f59e0b;"></span>
          <span style="background: #10b981;"></span>
          <span style="background: #3b82f6;"></span>
        </div>
      </button>

      <button type="button" class="site-card preset-card" data-preset="abyss">
        <div class="preset-card-top">
          <span class="preset-dot" style="--dot-color: #06b6d4;"></span>
          <strong>Abyss</strong>
          <span class="preset-tag">Marine Depth</span>
        </div>
        <p class="preset-desc">Oceanic cyan with bioluminescent highlights.</p>
        <div class="preset-palette-row">
          <span style="background: #06b6d4;"></span>
          <span style="background: #0891b2;"></span>
          <span style="background: #22d3ee;"></span>
          <span style="background: #a5f3fc;"></span>
        </div>
      </button>
    </div>

    <!-- Live Interactive Showcase -->
    <div class="theme-showcase reveal">
      <nui-card class="bento-cell theme-controls">
        <div slot="title" class="theme-controls-head">
          <div class="theme-controls-icon">
            <nui-icon icon="mdi:palette-outline" width="18" height="18" />
          </div>
          <div class="theme-controls-copy">
            <strong>Active Configuration</strong>
            <span>Preset: <span id="active-preset-name">Nucleus</span> · <span id="active-mode-name">Dark</span></span>
          </div>
          <nui-tag value="Reactive" severity="success" rounded />
        </div>

        <div class="theme-toggle-grid">
          <div class="theme-toggle-card">
            <div class="theme-toggle-top">
              <nui-icon icon="mdi:layers-triple-outline" width="14" height="14" />
              <nui-label value="PRESET" />
            </div>
            <nui-select id="palette-toggle" fluid size="small"></nui-select>
          </div>
          <div class="theme-toggle-card">
            <div class="theme-toggle-top">
              <nui-icon icon="mdi:theme-light-dark" width="14" height="14" />
              <nui-label value="MODE" />
            </div>
            <nui-select-button id="mode-toggle" fluid size="small" />
          </div>
        </div>

        <div class="theme-swatches" aria-hidden="true">
          <div class="theme-swatch"><i style="--swatch: var(--nui-primary-color)"></i><span>Primary</span></div>
          <div class="theme-swatch"><i style="--swatch: var(--nui-success-color)"></i><span>Success</span></div>
          <div class="theme-swatch"><i style="--swatch: var(--nui-info-color)"></i><span>Info</span></div>
          <div class="theme-swatch"><i style="--swatch: var(--nui-help-color)"></i><span>Accent</span></div>
        </div>

        <div class="theme-terminal">
          <div class="theme-terminal-bar">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="theme-terminal-title">theme.ts</span>
            <nui-button class="copy-btn" icon="mdi:content-copy" label="" text rounded size="small" data-action="copy-theme-code" aria-label="Copy theme command" />
          </div>
          <pre class="theme-terminal-body"><code id="theme-code"></code></pre>
        </div>
      </nui-card>

      <nui-card class="bento-cell theme-preview-card">
        <div slot="title" class="theme-preview-head">
          <div>
            <span class="theme-preview-eyebrow">{THEMING.previewEyebrow}</span>
            <nui-heading tag="4" text={THEMING.previewTitle} class="theme-preview-title" />
          </div>
          <nui-avatar label="UI" shape="circle" size="small" />
        </div>

        <div class="theme-preview-grid">
          <section class="theme-zone site-card-inset">
            <header class="theme-zone-head">
              <nui-icon icon="mdi:gesture-tap-button" width="13" height="13" />
              <span>Button Variants</span>
            </header>
            <div class="theme-chip-row">
              <nui-button label="Primary" severity="primary" raised size="small" />
              <nui-button label="Success" severity="success" size="small" />
              <nui-button label="Info" severity="info" outlined size="small" />
              <nui-button label="Warn" severity="warn" size="small" />
              <nui-button label="Danger" severity="danger" text size="small" />
            </div>
          </section>

          <section class="theme-zone site-card-inset">
            <header class="theme-zone-head">
              <nui-icon icon="mdi:tag-outline" width="13" height="13" />
              <span>Badges & Indicators</span>
            </header>
            <div class="theme-chip-row">
              <nui-tag value="Design System" severity="help" rounded />
              <nui-tag value="Tokens" severity="info" rounded />
              <nui-badge value="Live" severity="success" />
              <nui-avatar label="NX" shape="circle" size="small" />
            </div>
          </section>

          <section class="theme-zone theme-zone-wide site-card-inset">
            <header class="theme-zone-head">
              <nui-icon icon="mdi:chart-donut" width="13" height="13" />
              <span>Progress & Meter Group</span>
            </header>
            <div class="theme-metrics">
              <nui-progress-bar id="theme-progress" />
              <nui-meter-group id="theme-meter" />
            </div>
          </section>
        </div>
      </nui-card>
    </div>
  </div>
</section>

<style>
/* ── 8 Presets Card Grid ── */
.preset-selector-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  gap: 0.875rem;
  margin-bottom: 2rem;
}

.preset-card {
  gap: 0.5rem;
  padding: 1rem 1.125rem;
  width: 100%;
  text-align: left;
  cursor: pointer;
  font: inherit;
  position: relative;
}

.preset-card-top {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.preset-card-top strong {
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.preset-dot {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--dot-color, var(--nui-primary-color));
  flex-shrink: 0;
  opacity: 0.9;
}

.preset-dot-rainbow {
  background: linear-gradient(135deg, #ef4444, #f59e0b, #10b981, #3b82f6, #a855f7);
}

.preset-tag {
  margin-left: auto;
  font-family: var(--mono);
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.15rem 0.45rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--nui-white-text-color) 6%, transparent);
  color: color-mix(in srgb, var(--nui-white-text-color) 70%, transparent);
}

.preset-card.is-active .preset-tag {
  background: color-mix(in srgb, var(--nui-primary-color) 12%, transparent);
  color: color-mix(in srgb, var(--nui-primary-color) 75%, var(--nui-secondary-text-color));
}

.preset-desc {
  margin: 0;
  font-size: 0.75rem;
  line-height: 1.45;
  color: var(--nui-secondary-text-color);
  opacity: 0.8;
}

.preset-palette-row {
  display: flex;
  gap: 0.25rem;
  margin-top: 0.25rem;
}

.preset-palette-row span {
  width: 1.125rem;
  height: 0.3rem;
  border-radius: 2px;
}

/* ── Live Showcase Bento ── */
.theme-showcase {
  display: grid;
  gap: 1rem;
  width: 100%;
}

@media (min-width: 900px) {
  .theme-showcase {
    grid-template-columns: minmax(18rem, 1fr) 1.4fr;
    align-items: stretch;
  }
}

.theme-controls {
  width: 100%;
  min-width: 0;
  height: 100%;
}

.theme-controls-head {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.theme-controls-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: var(--card-inset-radius);
  background: color-mix(in srgb, var(--nui-primary-color) 8%, transparent);
  color: color-mix(in srgb, var(--nui-primary-color) 75%, var(--nui-secondary-text-color));
  flex-shrink: 0;
}

.theme-controls-copy {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  min-width: 0;
  flex: 1;
}

.theme-controls-copy strong {
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.theme-controls-copy span {
  font-size: 0.75rem;
  opacity: 0.7;
}

#active-preset-name {
  font-weight: 600;
  color: var(--nui-primary-color);
}

.theme-controls-head nui-tag {
  --font-size-2xs: 0.6875rem;
  flex-shrink: 0;
}

.theme-toggle-grid {
  display: grid;
  gap: 0.625rem;
}

@media (min-width: 520px) {
  .theme-toggle-grid { grid-template-columns: repeat(2, 1fr); }
}

.theme-toggle-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 0.75rem 0.875rem;
}

.theme-toggle-top {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--nui-primary-color);
}

.theme-toggle-top nui-label {
  --font-size-2xs: 0.6875rem;
  font-family: var(--mono);
  letter-spacing: 0.08em;
  opacity: 0.75;
}

.theme-swatches {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
}

.theme-swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.35rem;
  padding: 0.5rem 0.35rem;
  font-family: var(--mono);
  font-size: 0.625rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  opacity: 0.8;
}

.theme-swatch i {
  display: block;
  width: 1.125rem;
  height: 1.125rem;
  border-radius: 50%;
  background: var(--swatch);
}

.theme-toggle-card,
.theme-swatch {
  border-radius: var(--card-inset-radius);
  border: 1px solid var(--card-inset-border);
  background: var(--card-inset-bg);
}

.theme-terminal {
  margin-top: auto;
  border-radius: var(--card-inset-radius);
  overflow: hidden;
  border: 1px solid var(--code-border);
  background: var(--code-surface);
}

.theme-terminal-bar {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 0.625rem;
  border-bottom: 1px solid var(--surface-border);
  background: color-mix(in srgb, var(--code-surface) 96%, var(--nui-primary-color) 4%);
}

.theme-terminal-title {
  margin-right: auto;
  font-family: var(--mono);
  font-size: 0.6875rem;
  opacity: 0.5;
}

.theme-terminal-body {
  margin: 0;
  padding: 0.75rem 1rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  line-height: 1.6;
  color: var(--code-fg);
  overflow-x: auto;
}

.theme-terminal-body .tok-fn { color: var(--tok-fn); }
.theme-terminal-body .tok-str { color: var(--tok-str); }

.theme-preview-card {
  width: 100%;
  min-width: 0;
  height: 100%;
}

.theme-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  width: 100%;
}

.theme-preview-eyebrow {
  display: block;
  font-family: var(--mono);
  font-size: 0.6875rem;
  color: var(--nui-primary-color);
  margin-bottom: 0.25rem;
}

.theme-preview-title {
  --font-size-md: 1rem;
  --font-weight-semibold: 600;
}

.theme-preview-grid {
  display: grid;
  gap: 0.75rem;
}

@media (min-width: 640px) {
  .theme-preview-grid { grid-template-columns: repeat(2, 1fr); }
}

.theme-zone {
  display: flex;
  flex-direction: column;
  padding: 0.875rem 1rem;
}

.theme-zone-wide {
  grid-column: 1 / -1;
}

.theme-zone-head {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-bottom: 0.75rem;
  font-family: var(--mono);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.6;
}

.theme-zone-head nui-icon {
  color: var(--nui-primary-color);
}

.theme-chip-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}

.theme-metrics {
  display: grid;
  gap: 0.75rem;
}

#theme-progress { display: block; }
#theme-meter { display: block; }
</style>
