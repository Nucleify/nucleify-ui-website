---
import { BROWSER_ITEMS, componentDocsUrl } from '../config';
import { COMPONENTS } from '../config/copy';

const COMPONENTS_INDEX_URL = '/components';
---

<section class="section section-alt" id="components">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">{COMPONENTS.eyebrow}</span>
      <nui-heading tag="2" class="section-title" text={COMPONENTS.title} />
      <nui-paragraph class="section-lead" text={COMPONENTS.lead} />
    </div>

    <div class="browser-categories">
      <nui-button label="All" severity="primary" size="small" data-filter="all" />
      <nui-button label="Forms & Inputs" severity="secondary" size="small" outlined data-filter="forms" />
      <nui-button label="Data & Analytics" severity="secondary" size="small" outlined data-filter="data" />
      <nui-button label="Layout & Navigation" severity="secondary" size="small" outlined data-filter="layout" />
      <nui-button label="Feedback & Status" severity="secondary" size="small" outlined data-filter="feedback" />
    </div>

    <div class="browser-grid">
      {BROWSER_ITEMS.map((item) => (
        <a
          class:list={['site-card', 'browser-item', 'reveal', item.name === 'nui-terminal' && 'browser-item--terminal']}
          data-cat={item.cat}
          href={componentDocsUrl(item.name)}
        >
          <div class="browser-item-icon">
            <nui-icon icon={item.icon} width="18" height="18" />
          </div>
          <span class="browser-item-name">{item.name}</span>
          <nui-icon icon="mdi:arrow-top-right" width="14" height="14" class="browser-item-arrow" />
        </a>
      ))}
    </div>

    <div class="components-cta">
      <nui-button label={COMPONENTS.cta} severity="primary" outlined icon="mdi:book-open-page-variant-outline" data-action="navigate" data-url={COMPONENTS_INDEX_URL} />
    </div>
  </div>
</section>

<style>
.browser-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
  margin-bottom: 2rem;
}

.browser-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
  justify-items: center;
}

.browser-item {
  width: 100%;
  max-width: 250px;
  flex-direction: row;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  text-decoration: none;
  cursor: pointer;
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 600;
}

@media (min-width: 500px) {
  .browser-grid {
    grid-template-columns: repeat(2, 1fr);
    justify-items: stretch;
  }

  .browser-item {
    max-width: none;
  }
}

@media (min-width: 640px) {
  .browser-grid { grid-template-columns: repeat(3, 1fr); }

  /* 16 items → 1 leftover in 3-col; hide terminal until 4-col */
  .browser-item--terminal { display: none; }
}

@media (min-width: 960px) {
  .browser-grid { grid-template-columns: repeat(4, 1fr); }
  .browser-item--terminal { display: flex; }
}

.browser-item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--card-inset-radius);
  background: color-mix(in srgb, var(--nui-primary-color) 8%, transparent);
  color: color-mix(in srgb, var(--nui-primary-color) 80%, var(--nui-secondary-text-color));
  flex-shrink: 0;
}

.browser-item-name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.browser-item-arrow {
  opacity: 0;
  transform: translate(-3px, 3px);
  transition: opacity 0.2s, transform 0.2s;
  color: var(--nui-secondary-text-color);
}

.browser-item:hover .browser-item-arrow {
  opacity: 0.9;
  transform: translate(0, 0);
}

.browser-item[hidden] { display: none; }

.components-cta {
  display: flex;
  justify-content: center;
  margin-top: 2.5rem;
}
</style>
