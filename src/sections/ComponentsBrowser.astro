---
import { BROWSER_ITEMS, PLAYGROUND_URL } from '../config';
---

<section class="section section-alt" id="components">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Component Catalog</span>
      <nui-heading tag="2" class="section-title" text="50+ Production-Ready Primitives" />
      <nui-paragraph class="section-lead" text="Filter components by domain. Click any component card to immediately test attributes and live slots inside the playground." />
    </div>

    <div class="browser-categories">
      <nui-button label="All" severity="primary" size="small" data-filter="all" />
      <nui-button label="Forms & Inputs" severity="secondary" size="small" outlined data-filter="forms" />
      <nui-button label="Data & Analytics" severity="secondary" size="small" outlined data-filter="data" />
      <nui-button label="Layout & Navigation" severity="secondary" size="small" outlined data-filter="layout" />
      <nui-button label="Feedback & Status" severity="secondary" size="small" outlined data-filter="feedback" />
    </div>

    <div class="browser-grid">
      {BROWSER_ITEMS.map((item) => (
        <a class="browser-item reveal" data-cat={item.cat} href={PLAYGROUND_URL}>
          <div class="browser-item-icon">
            <nui-icon icon={item.icon} width="18" height="18" />
          </div>
          <span class="browser-item-name">{item.name}</span>
          <nui-icon icon="mdi:arrow-top-right" width="14" height="14" class="browser-item-arrow" />
        </a>
      ))}
    </div>

    <div class="components-cta">
      <nui-button label="Launch Interactive Playground" severity="primary" outlined icon="mdi:gamepad-variant-outline" data-action="navigate" data-url={PLAYGROUND_URL} />
    </div>
  </div>
</section>

<style>
.browser-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
  margin-bottom: 2rem;
}

.browser-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
}

@media (min-width: 640px) {
  .browser-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 960px) {
  .browser-grid { grid-template-columns: repeat(4, 1fr); }
}

.browser-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  border-radius: 0.875rem;
  border: 1px solid var(--surface-border);
  background: var(--surface-card);
  text-decoration: none;
  color: var(--nui-white-text-color);
  font-family: var(--mono);
  font-size: 0.8125rem;
  font-weight: 600;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.browser-item:hover {
  border-color: var(--nui-primary-color);
  background: var(--surface-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px -4px color-mix(in srgb, var(--nui-primary-color) 20%, transparent);
}

.browser-item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: 0.625rem;
  background: color-mix(in srgb, var(--nui-primary-color) 10%, transparent);
  color: var(--nui-primary-color);
  flex-shrink: 0;
}

.browser-item-name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.browser-item-arrow {
  opacity: 0;
  transform: translate(-3px, 3px);
  transition: opacity 0.2s, transform 0.2s;
  color: var(--nui-primary-color);
}

.browser-item:hover .browser-item-arrow {
  opacity: 0.9;
  transform: translate(0, 0);
}

.browser-item[hidden] { display: none; }

.components-cta {
  display: flex;
  justify-content: center;
  margin-top: 2.5rem;
}
</style>
